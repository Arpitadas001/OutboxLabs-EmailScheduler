{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test -r ts-node/register test/*.test.ts",
    "seed:backlog": "ts-node --project scripts/tsconfig.json scripts/seed-backlog.ts",
    "e2e:send-check": "ts-node --project scripts/tsconfig.json scripts/e2e-send-check.ts",
    "prisma:generate": "dotenv -e ../.env -- prisma generate",
    "prisma:migrate": "dotenv -e ../.env -- prisma migrate dev",
    "prisma:seed": "dotenv -e ../.env -- ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.4",
    "@bull-board/express": "^9.10.4",
    "@prisma/client": "^6.19.3",
    "@types/multer": "^2.3.0",
    "@types/nodemailer": "^8.0.2",
    "bullmq": "^5.7.1",
    "connect-redis": "^7.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^11.0.0",
    "express": "^4.19.2",
    "express-session": "^1.19.0",
    "google-auth-library": "^11.1.0",
    "ioredis": "^5.11.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.14",
    "redis": "^6.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/node": "^20.12.7",
    "nodemon": "^3.1.0",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
