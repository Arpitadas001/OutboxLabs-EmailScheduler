# App
NODE_ENV=development
PORT=3001
SESSION_SECRET=<generate-random-32-char-string-here>
ENCRYPTION_KEY=<generate-random-32-char-string-here>
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/outboxlabs

# Redis
REDIS_URL=redis://localhost:6379

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Google OAuth
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs must include: http://localhost:3001/auth/google/callback
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Slack OAuth (optional — app works without it; needed for Phase 9)
# Must use an https:// redirect URI → run: ngrok http 3001
SLACK_CLIENT_ID=<your-slack-client-id>
SLACK_CLIENT_SECRET=<your-slack-client-secret>
SLACK_REDIRECT_URI=https://<ngrok-subdomain>.ngrok.io/slack/callback

# Worker settings (all configurable, no hardcoded values)
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=1000
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# Ethereal SMTP (populated by seed script — prisma:seed creates Sender rows in DB)
# These are fallback env vars; the seed script calls nodemailer.createTestAccount()
# and stores credentials in the Sender table directly.
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=<filled-by-seed>
ETHEREAL_PASS=<filled-by-seed>
